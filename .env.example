# Appwrite configuration (read by src/lib/appwrite.ts).
# VITE_ prefixed values are bundled into the browser app — these are public IDs, not secrets.
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1 #Insert your Appwrite endpoint here
VITE_APPWRITE_PROJECT_ID=#Insert your Appwrite project ID here
VITE_APPWRITE_DATABASE_ID=#Insert your Appwrite database ID here
VITE_APPWRITE_FOLDERS_TABLE_ID=#Insert your Appwrite folders table ID here
VITE_APPWRITE_NOTES_TABLE_ID=#Insert your Appwrite notes table ID here
VITE_APPWRITE_BUCKET_ID=#Insert your Appwrite bucket ID here
